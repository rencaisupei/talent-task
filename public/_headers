# Response headers for Cloudflare static hosting (Workers static assets / Pages).
# Copied verbatim into dist/ by `expo export -p web`.
#
# The whole web deployment is the admin platform (the consumer app ships as the
# native mobile app only), so nothing here may be indexed.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow

# Hashed asset paths never change contents.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Entry document and service worker must revalidate on every load so a new
# deploy is picked up immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Response headers for Cloudflare static hosting (Workers static assets / Pages).
# Copied verbatim into dist/ by `expo export -p web`.
#
# The root site is the consumer app and may be indexed. /admin is the operator
# platform: never indexed, never framed. Rules are matched per request path, so
# the /admin rules also cover the SPA fallback responses for /admin/login etc.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Admin platform. Path prefix also covers the legacy /admin-dashboard route.
/admin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY

/admin/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY

/admin-dashboard
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY

# Hashed asset paths never change contents.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 品牌圖示：檔名固定（favicon、manifest 與 App 內標誌共用同一個 URL），所以不能設 immutable。
# 快取一天，之後重新驗證 —— 換圖最多一天生效。
/icons/*
  Cache-Control: public, max-age=86400, must-revalidate

# Entry document and service worker must revalidate on every load so a new
# deploy is picked up immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# 執行階段後端連線設定：改檔案就要立刻生效，不能被快取住。
/bilt-config.js
  Cache-Control: public, max-age=0, must-revalidate
